pipeline {
    agent any

    environment {
        SERVICE_NAME = 'empleados-service'
        IMAGE_TAG    = "${env.BUILD_NUMBER}"
        SONAR_TOKEN  = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Código obtenido para: ${env.SERVICE_NAME}"
                sh 'ls -la'
            }
        }

        stage('Build') {
            steps {
                dir('empleados') {
                    sh 'mvn clean compile -DskipTests -q'
                    echo 'Compilación exitosa'
                }
            }
        }

        stage('Test') {
            steps {
                dir('empleados') {
                    sh 'mvn verify -q'
                    echo 'Tests ejecutados y cobertura generada'
                }
            }
            post {
                always {
                    dir('empleados') {
                        junit allowEmptyResults: true,
                              testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('empleados') {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=empleados-service \
                                -Dsonar.projectName='Empleados Service' \
                                -Dsonar.token=${env.SONAR_TOKEN} \
                                -q
                        """
                    }
                }
                echo 'Análisis enviado a SonarQube'
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
                echo 'Quality Gate aprobado'
            }
        }

        stage('Package') {
            steps {
                dir('empleados') {
                    sh "docker build -t empleados-service:${env.IMAGE_TAG} -t empleados-service:latest ."
                    echo "Imagen construida: empleados-service:${env.IMAGE_TAG}"
                }
            }
        }

        stage('E2E Tests') {
            steps {
                sh '''
                    # Copiar el archivo .env.example como .env si no existe
                    if [ ! -f .env ]; then
                        cp .env.example .env
                    fi
                '''
                sh 'docker-compose down -v --remove-orphans || true'
                sh 'docker-compose up -d --build'
                sh '''
                    echo "Esperando a que los servicios estén listos..."
                    ATTEMPTS=0
                    MAX_ATTEMPTS=40
                    until curl -sf http://localhost:8085/actuator/health > /dev/null 2>&1; do
                        ATTEMPTS=$((ATTEMPTS + 1))
                        if [ $ATTEMPTS -ge $MAX_ATTEMPTS ]; then
                            echo "Sistema no disponible después de $MAX_ATTEMPTS intentos"
                            exit 1
                        fi
                        echo "Intento $ATTEMPTS/$MAX_ATTEMPTS - esperando 10s..."
                        sleep 10
                    done
                    echo "Sistema listo"
                '''
                dir('e2e-tests') {
                    sh 'mvn test -q'
                    echo 'Pruebas E2E completadas'
                }
            }
            post {
                always {
                    sh 'docker-compose down -v --remove-orphans || true'
                    echo 'Sistema apagado después de E2E'
                }
            }
        }

    }

    post {
        success {
            echo "Pipeline de empleados-service completado — Build #${env.BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline de empleados-service FALLIDO — Build #${env.BUILD_NUMBER}"
        }
    }
}