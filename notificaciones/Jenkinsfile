pipeline {
    agent any

    environment {
        SERVICE_NAME = 'notificaciones-service'
        IMAGE_TAG    = "${env.BUILD_NUMBER}"
        SONAR_TOKEN  = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Código obtenido para: ${env.SERVICE_NAME}"
            }
        }

        stage('Build') {
            steps {
                dir('notificaciones') {
                    sh 'mvn clean compile -DskipTests -q'
                    echo 'Compilación exitosa'
                }
            }
        }

        stage('Test') {
            steps {
                dir('notificaciones') {
                    sh 'mvn verify -q'
                    echo 'Tests ejecutados y cobertura generada'
                }
            }
            post {
                always {
                    dir('notificaciones') {
                        junit allowEmptyResults: true,
                              testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('notificaciones') {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \
                                -Dsonar.projectKey=notificaciones-service \
                                -Dsonar.projectName='Notificaciones Service' \
                                -Dsonar.token=${env.SONAR_TOKEN} \
                                -q
                        """
                    }
                }
                echo 'Análisis enviado a SonarQube'
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
                echo 'Quality Gate aprobado'
            }
        }

        stage('Package') {
            steps {
                dir('notificaciones') {
                    sh "docker build -t notificaciones-service:${env.IMAGE_TAG} -t notificaciones-service:latest ."
                    echo "Imagen construida: notificaciones-service:${env.IMAGE_TAG}"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline de notificaciones-service completado — Build #${env.BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline de notificaciones-service FALLIDO — Build #${env.BUILD_NUMBER}"
        }
    }
}